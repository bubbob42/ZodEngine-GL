; ProfStart -- a PC profile of a match's first 12 s (ZOD_PROFILE_SKIP 0,
; 1 ms samples): the GL path on orig04 with the view scrolling, to see what
; the start costs (the bots' first socket processing took 0.6..1 s on the
; A4000D). FS-UAE's JIT changes what each instruction costs.
; LIMIT 900
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_GL_SYNC aus
SetEnv RadeonGLHeapMax 16
SetEnv ZOD_TOUR on
SetEnv ZOD_PROFILE DEV:Test/zod-tour.prof
SetEnv ZOD_PROFILE_US 1000
SetEnv ZOD_PROFILE_SKIP 0
Echo "=== GL, orig04, tour, profiled ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod ptour 12 -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-ptour.done
Type DEV:Test/zod-ptour.log >>DEV:Test/auto.log
UnSetEnv ZOD_PROFILE
UnSetEnv ZOD_PROFILE_US
UnSetEnv ZOD_PROFILE_SKIP
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_GL_SYNC
UnSetEnv RadeonGLHeapMax
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
