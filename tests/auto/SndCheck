; SndCheck -- the buildings' sounds found in ols.building_olist give the
; same two flags as the walk over every object (ZOD_SNDLIST). ZOD_SNDCHECK
; on works out both every frame and counts the frames where they differ
; ("0 differ"). A still view on orig01, then the view scrolling on orig04
; (ZOD_TOUR), software path.
; LIMIT 900
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_SNDCHECK on
Echo "=== software, building sounds checked, orig01 still ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod sns 20 -o -m Data/Campaing/Z_original/p02_bb_orig01.map
Execute DEV:Test/WaitDone DEV:Test/zod-sns.done
Type DEV:Test/zod-sns.log >>DEV:Test/auto.log
Echo "=== software, building sounds checked, orig04 scrolling ===" >>DEV:Test/auto.log
SetEnv ZOD_TOUR on
Run >NIL: Execute DEV:Test/RunZod snt 20 -o -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-snt.done
Type DEV:Test/zod-snt.log >>DEV:Test/auto.log
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_SNDCHECK
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
