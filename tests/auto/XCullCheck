; XCullCheck -- the objects left out sideways (ZOD_XCULL: the band's entries
; wholly beside the view's columns plus 64 px) draw nothing: ZOD_XCULLCHECK
; on draws them anyway, after the others, and counts every one that made a
; quad ("0 of them drew"). GL, orig01 still, orig04 and p08 scrolling
; (ZOD_TOUR), 40 s each. FS-UAE + RadeonGL's null card.
; LIMIT 1200
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_GL_SYNC off
SetEnv RadeonGLHeapMax 16
SetEnv ZOD_XCULLCHECK on
Echo "=== GL, orig01, still ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod xcs 40 -m Data/Campaing/Z_original/p02_bb_orig01.map
Execute DEV:Test/WaitDone DEV:Test/zod-xcs.done
Type DEV:Test/zod-xcs.log >>DEV:Test/auto.log
SetEnv ZOD_TOUR on
Echo "=== GL, orig04, tour ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod xct 40 -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-xct.done
Type DEV:Test/zod-xct.log >>DEV:Test/auto.log
Echo "=== GL, p08, tour ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod xcb 40 -m Data/Maps/Custom/p08_bb_p08m01.map
Execute DEV:Test/WaitDone DEV:Test/zod-xcb.done
Type DEV:Test/zod-xcb.log >>DEV:Test/auto.log
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_XCULLCHECK
UnSetEnv RadeonGLHeapMax
UnSetEnv ZOD_GL_SYNC
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
