; RockPreCheck -- with the rock shadows baked into the map the rocks'
; pre-render band draws nothing, so it is left out (ZOD_ROCKPRESKIP).
; ZOD_ROCKPRECHECK on runs the band anyway in every baked frame and counts
; the frames where it made a quad ("0 frames drew"). GL, orig01 still and
; orig04 scrolling (ZOD_TOUR), 30 s each. FS-UAE + RadeonGL's null card.
; LIMIT 700
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_GL_SYNC off
SetEnv RadeonGLHeapMax 16
SetEnv ZOD_ROCKPRECHECK on
Echo "=== GL, orig01, still ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod rps 30 -m Data/Campaing/Z_original/p02_bb_orig01.map
Execute DEV:Test/WaitDone DEV:Test/zod-rps.done
Type DEV:Test/zod-rps.log >>DEV:Test/auto.log
SetEnv ZOD_TOUR on
Echo "=== GL, orig04, tour ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod rpt 30 -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-rpt.done
Type DEV:Test/zod-rpt.log >>DEV:Test/auto.log
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_ROCKPRECHECK
UnSetEnv RadeonGLHeapMax
UnSetEnv ZOD_GL_SYNC
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
