; LoadBarPresents (a measuring aid) -- every GL present during loading with
; what it drew (ZOD_PRESENTLOG), to find the frame where the bar is missing.
; LIMIT 400
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_GL_SYNC aus
SetEnv ZOD_PRESENTLOG on
Run >NIL: Execute DEV:Test/RunZod lbp 5 -m Data/Campaing/Z_original/p02_bb_orig01.map
Execute DEV:Test/WaitDone DEV:Test/zod-lbp.done
Type DEV:Test/zod-lbp.log >>DEV:Test/auto.log
UnSetEnv ZOD_PRESENTLOG
UnSetEnv ZOD_GL_SYNC
Echo >DEV:Test/AutoDone done
