; ProfTour -- a PC profile of the GL path while the view scrolls (ZOD_TOUR,
; orig04), sampled after a 15 s warm-up (ZOD_PROFILE_SKIP), 60 s run. FS-UAE's
; JIT changes what each instruction costs and the bus costs nothing there, so
; this shows where the CPU work lies, not the A4000D's proportions.
; LIMIT 900
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_GL_SYNC off
SetEnv RadeonGLHeapMax 16
SetEnv ZOD_TOUR on
SetEnv ZOD_PROFILE DEV:Test/zod-tour.prof
SetEnv ZOD_PROFILE_US 5000
Echo "=== GL, orig04, tour, profiled ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod ptour 60 -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-ptour.done
Type DEV:Test/zod-ptour.log >>DEV:Test/auto.log
UnSetEnv ZOD_PROFILE
UnSetEnv ZOD_PROFILE_US
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_GL_SYNC
UnSetEnv RadeonGLHeapMax
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
