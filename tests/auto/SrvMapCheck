; SrvMapCheck -- the map items do nothing in the server's process and update
; passes, so they are left out (ZOD_SRVMAPSKIP). ZOD_SRVMAPCHECK on runs both
; passes over them as before and compares each map item's bytes before and
; after its ProcessServer (its two time stamps put back first): "0 changed".
; Software path, orig01 still and orig04 scrolling (ZOD_TOUR), 40 s each.
; LIMIT 900
FailAt 1000
Wait 5
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Delete >NIL: DEV:Test/zod-#?
SetEnv ZOD_SRVMAPCHECK on
Echo "=== software, orig01 still ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod sms 40 -o -m Data/Campaing/Z_original/p02_bb_orig01.map
Execute DEV:Test/WaitDone DEV:Test/zod-sms.done
Type DEV:Test/zod-sms.log >>DEV:Test/auto.log
SetEnv ZOD_TOUR on
Echo "=== software, orig04 scrolling ===" >>DEV:Test/auto.log
Run >NIL: Execute DEV:Test/RunZod smt 40 -o -m Data/Campaing/Z_original/p02_bb_orig04.map
Execute DEV:Test/WaitDone DEV:Test/zod-smt.done
Type DEV:Test/zod-smt.log >>DEV:Test/auto.log
UnSetEnv ZOD_TOUR
UnSetEnv ZOD_SRVMAPCHECK
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
